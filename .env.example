# Database
DATABASE_URL="mysql://user:password@localhost:3306/agency"

# JWT & Security
JWT_SECRET="your-secret-key-here-minimum-32-characters"
NEXT_PUBLIC_DISABLE_AGENCY_BRANDING=false

# Admin Path
NEXT_PUBLIC_ADMIN_PATH="kali_master"

# Email Service (SendGrid / Mailgun)
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@arvanceagency.com"

# Cloud Storage (AWS S3 / Firebase)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-bucket-name"

# Firebase (Alternative to AWS S3)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"

# Bot Protection (hCaptcha)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY="your-hcaptcha-site-key"
HCAPTCHA_SECRET_KEY="your-hcaptcha-secret-key"

# Analytics (GA4)
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID="123456789"

# Antivirus Scanning (VirusTotal - Optional)
VIRUSTOTAL_API_KEY="your-virustotal-api-key"

# Deployment
VERCEL_URL="your-deployment-url"
NODE_ENV="production"

# Base URL
NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# Corporate Branding (AR Qudrix System)
NEXT_PUBLIC_DISABLE_AGENCY_BRANDING=false

# Optional: Custom branding config (JSON string)
# NEXT_PUBLIC_BRANDING_CONFIG='{"productName":"Your Product",...}'
