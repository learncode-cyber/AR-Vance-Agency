# ============================================================
# AR Vance Agency OS — environment variables
# Legend:  [REQUIRED] app won't work without it
#          [OPTIONAL] feature is skipped/degrades gracefully if unset
#          [SECRET]   never commit, never prefix with NEXT_PUBLIC_
#          [PUBLIC]   safe to expose to the browser (NEXT_PUBLIC_*)
# Only variables the code actually reads are listed here.
# ============================================================

# ---- Core ------------------------------------------------------------
NODE_ENV=production                          # [REQUIRED]
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"   # [REQUIRED][SECRET]
JWT_SECRET=""                                # [REQUIRED][SECRET] min 32 chars; app refuses to sign tokens in production without it
ADMIN_PATH="kali_master"                     # [REQUIRED] server-only admin URL slug (NOT NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL="https://arvanceagency.com"   # [PUBLIC] used by sitemap.xml and robots.txt
SEED_ADMIN_PASSWORD=""                       # [SECRET] used only by `prisma db seed`; seed refuses to run in production without it

# ---- AI --------------------------------------------------------------
GEMINI_API_KEY=""                            # [REQUIRED for AI][SECRET] primary AI provider
ANTHROPIC_API_KEY=""                         # [OPTIONAL][SECRET] fallback provider used by some chat/insight helpers

# ---- Storage (Cloudflare R2) ----------------------------------------
R2_ACCOUNT_ID=""                             # [OPTIONAL][SECRET] uploads fall back to local disk if unset
R2_ACCESS_KEY_ID=""                          # [OPTIONAL][SECRET]
R2_SECRET_ACCESS_KEY=""                      # [OPTIONAL][SECRET]
R2_BUCKET_NAME=""                            # [OPTIONAL]
R2_PUBLIC_URL=""                             # [OPTIONAL]

# ---- Email (Hostinger SMTP) -----------------------------------------
SMTP_HOST="smtp.hostinger.com"               # [OPTIONAL]
SMTP_PORT="465"                              # [OPTIONAL]
SMTP_SECURE="true"                           # [OPTIONAL]
SMTP_USER=""                                 # [OPTIONAL][SECRET]
SMTP_PASS=""                                 # [OPTIONAL][SECRET]
SMTP_FROM=""                                 # [OPTIONAL]

# ---- Payments --------------------------------------------------------
STRIPE_SECRET_KEY=""                         # [OPTIONAL][SECRET]
STRIPE_WEBHOOK_SECRET=""                      # [REQUIRED if you take card payments][SECRET] Stripe dashboard → Developers → Webhooks → signing secret (whsec_…). Webhook endpoint: https://YOUR-DOMAIN/api/webhooks/stripe
STRIPE_PUBLIC_KEY=""                         # [OPTIONAL] publishable key (read server-side by app/api/payments/stripe)

# ---- External managed services (all optional; app must run without them) ---
REDIS_URL=""                                 # [OPTIONAL][SECRET] EXTERNAL managed Redis only — not run on Hostinger
ELASTICSEARCH_URL=""                         # [OPTIONAL] EXTERNAL managed search only
ELASTICSEARCH_USER=""                        # [OPTIONAL][SECRET]
ELASTICSEARCH_PASSWORD=""                    # [OPTIONAL][SECRET]

# ---- Monitoring / alerts --------------------------------------------
SENTRY_DSN=""                                # [OPTIONAL]
NEXT_PUBLIC_SENTRY_DSN=""                    # [PUBLIC][OPTIONAL]
SENTRY_DEBUG=""                              # [OPTIONAL]
SENTRY_ORG=""                                # [OPTIONAL] only needed for source-map upload at build time
SENTRY_PROJECT=""                            # [OPTIONAL]
SENTRY_AUTH_TOKEN=""                         # [OPTIONAL][SECRET]
SLACK_WEBHOOK_URL=""                         # [OPTIONAL][SECRET]
ALERT_EMAIL_SERVICE=""                       # [OPTIONAL]

# ---- Branding --------------------------------------------------------
NEXT_PUBLIC_DISABLE_AGENCY_BRANDING="false"  # [PUBLIC][OPTIONAL]
NEXT_PUBLIC_APP_VERSION=""                   # [PUBLIC][OPTIONAL]

IMAGE_ALLOWED_HOSTS=""                        # [OPTIONAL] comma-separated extra hostnames next/image may load (R2_PUBLIC_URL host is added automatically)

CSP_ENFORCE=""                                # [OPTIONAL, BUILD-TIME] "true" = enforce CSP; default is Report-Only (violations logged by /api/csp-report)

SKIP_BUILD_CHECKS=""                          # [OPTIONAL, BUILD-TIME] "1" skips in-build type-check/lint (use npm run build:lowmem; run typecheck+lint separately)

DB_SLOW_QUERY_MS=""                           # [OPTIONAL] e.g. 500 = log queries slower than 500ms as [db-slow]

MEETING_LINK_URL=""                           # [OPTIONAL] your fixed Zoom/Google Meet room URL, included in booking confirmation emails (blank = "we will send details")
