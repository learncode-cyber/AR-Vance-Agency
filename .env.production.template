# ===== MINIMUM to go live (copy into Hostinger's Environment Variables) =====
NODE_ENV=production
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"   # from hPanel → Databases
JWT_SECRET=""                    # 40+ random chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PATH="choose-a-private-slug"   # admin panel lives at /<this-slug>/login — NOT NEXT_PUBLIC_ADMIN_PATH
NEXT_PUBLIC_SITE_URL="https://YOUR-DOMAIN"
SEED_ADMIN_PASSWORD=""           # used ONCE by `npm run prisma:seed` to create admin@arvance.agency

# ===== Strongly recommended =====
TWO_FACTOR_ENCRYPTION_KEY=""     # 40+ random chars (separate from JWT_SECRET)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""                     # your Hostinger mailbox
SMTP_PASS=""
SMTP_FROM=""
CRON_SECRET=""                   # 16+ chars; enables /api/jobs/run for the cron job
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ===== Only if you use them =====
GEMINI_API_KEY=""                # AI agents / chat / RAG
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""         # REQUIRED with Stripe — unsigned webhooks are rejected
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""                 # also whitelists the image host for next/image
# See .env.example for the complete list (Redis, Elasticsearch, Meta/GA4/Google Ads, etc.)
