model Workflow {
  id              String   @id @default(cuid())
  
  name            String   @unique
  description     String   @db.Text @default("")
  
  // Workflow Configuration
  triggers        String   @db.Text @default("[]")  // JSON array
  actions         String   @db.Text @default("[]")  // JSON array
  conditions      String   @db.Text @default("[]")  // JSON array
  
  // Settings
  enabled         Boolean  @default(true)
  active          Boolean  @default(false)
  
