model ChatBot {
  id              String   @id @default(cuid())
  
  // Bot Info
  name            String   @unique
  description     String   @db.Text @default("")
  
  // Configuration
  aiModel         String   @default("claude-3-sonnet")  // AI model to use
  systemPrompt    String   @db.Text  // System instructions for AI
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(1000)
  
  // Status
  active          Boolean  @default(true)
  
  // Relations
  conversations   ChatConversation[]
  responses       ChatBotResponse[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatConversation {
  id              String   @id @default(cuid())
  
  // Relations
  botId           String
  bot             ChatBot  @relation(fields: [botId], references: [id], onDelete: Cascade)
  
  // Conversation Info
  visitorEmail    String
  visitorName     String
  visitorId       String   @default("")  // Session ID or user ID
  
  // Language
  language        String   @default("en")
  
  // Status
  status          String   @default("open")  // open, closed, waiting_for_human
  
  // Metrics
  messageCount    Int      @default(0)
  duration        Int      @default(0)  // seconds
  resolved        Boolean  @default(false)
  
  // Relations
  messages        ChatMessage[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatMessage {
  id              String   @id @default(cuid())
  
  // Relations
  conversationId  String
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  // Message Info
  role            String   // "user" or "assistant"
  content         String   @db.Text
  
  // Metadata
  language        String   @default("en")
  sentiment       String   @default("neutral")  // positive, negative, neutral
  
  createdAt       DateTime @default(now())
}

model ChatBotResponse {
  id              String   @id @default(cuid())
  
  // Relations
  botId           String
  bot             ChatBot  @relation(fields: [botId], references: [id], onDelete: Cascade)
  
  // Response Info
  trigger         String   // Pattern/keyword that triggers this
  response        String   @db.Text  // Pre-written response
  
  // Category
  category        String   @default("general")
  
  // Status
  active          Boolean  @default(true)
  
  // Stats
  usageCount      Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SupportTicket {
