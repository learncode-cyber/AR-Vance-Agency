model UserProfile {
  id              String   @id @default(cuid())
  
  userId          String   @unique
  user            User     @relation("UserProfiles", fields: [userId], references: [id], onDelete: Cascade)
  
  // Basic Info
  displayName     String
  bio             String   @db.Text @default("")
  avatar          String   @default("")
  coverImage      String   @default("")
  
  // Social
  website         String   @default("")
  socialLinks     String   @db.Text @default("{}")  // JSON
  
  // Stats
  followersCount  Int      @default(0)
  followingCount  Int      @default(0)
  postsCount      Int      @default(0)
  
  // Engagement
  totalLikes      Int      @default(0)
  totalComments   Int      @default(0)
  
  // Gamification
  points          Int      @default(0)
  level           Int      @default(1)
  badges          String   @db.Text @default("[]")  // JSON array
  
  // Preferences
  isPublic        Boolean  @default(true)
  allowMessaging  Boolean  @default(true)
  
  // Relations
  followers       Follow[] @relation("FollowingUsers")
  following       Follow[] @relation("FollowedUsers")
  posts           Post[]
  comments        Comment[]
  reactions       Reaction[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Follow {
  id              String   @id @default(cuid())
  
  followerId      String
  follower        UserProfile @relation("FollowingUsers", fields: [followerId], references: [id], onDelete: Cascade)
  
  followingId     String
  following       UserProfile @relation("FollowedUsers", fields: [followingId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id              String   @id @default(cuid())
  
  authorId        String
  author          UserProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  // Content
  title           String   @db.Text
  content         String   @db.Text
  excerpt         String   @default("")
  
  // Media
  images          String   @db.Text @default("[]")  // JSON array
  videos          String   @db.Text @default("[]")  // JSON array
  
  // Meta
  slug            String   @unique
  metaDescription String   @default("")
  metaKeywords    String   @default("")
  
  // Category/Tags
  category        String   @default("general")
  tags            String   @db.Text @default("[]")  // JSON array
  
  // Engagement
  viewCount       Int      @default(0)
  likesCount      Int      @default(0)
  commentsCount   Int      @default(0)
  sharesCount     Int      @default(0)
  
  // Status
  published       Boolean  @default(true)
  featured        Boolean  @default(false)
  
  // Relations
  comments        Comment[]
  reactions       Reaction[] @relation("PostReactions")
  activityFeed    ActivityFeed[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?
  
  @@index([authorId])
  @@index([category])
  @@index([published])
}

model Comment {
  id              String   @id @default(cuid())
  
  postId          String
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  authorId        String
