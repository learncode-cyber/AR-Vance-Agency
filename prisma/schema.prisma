  type            String   // form_submission, user_signup, lead_created, etc
  
  // Configuration
  config          String   @db.Text @default("{}")  // JSON
  
  // Conditions
  conditions      String   @db.Text @default("[]")  // JSON array
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([workflowId])
}

