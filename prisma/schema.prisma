  // Configuration
  config          String   @db.Text @default("{}")  // JSON
  
  // Delay
  delayMs         Int      @default(0)
  
  // Order
  position        Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([workflowId])
}

