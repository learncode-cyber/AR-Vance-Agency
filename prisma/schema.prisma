generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SETTINGS — single-row site-wide config, editable from admin
// ============================================================
model Settings {
  id               Int      @id @default(1)
  siteName         String   @default("AR Vance Agency")
  tagline          String   @default("Smart Digital Solutions for Global Brands")
  siteDescription  String   @default("") @db.Text
  founded          String   @default("2021")

  contactEmail     String   @default("hello@example.com")
  contactPhone     String   @default("")
  address          String   @default("")

  socialLinkedin   String   @default("")
  socialTwitter    String   @default("")
  socialFacebook   String   @default("")
  socialInstagram  String   @default("")

  heroBadge        String   @default("Smart Digital Solutions")
  heroTitle        String   @default("Your Digital Success")
  heroTitleAccent  String   @default("Starts Today")
  heroSubtitle     String   @default("") @db.Text
  heroCtaPrimary   String   @default("Get Started")
  heroCtaSecondary String   @default("Our Services")

  ctaTitle         String   @default("Ready to Elevate Your Brand?")
  ctaSubtitle      String   @default("") @db.Text
  ctaButton        String   @default("Contact Us Today")

  seoDefaultTitle  String   @default("")
  seoDefaultDesc   String   @default("") @db.Text
  seoTitleTemplate String   @default("%s | AR Vance Agency")

  // ── Ads & Tracking — client-side (leave blank to disable) ──
  ga4MeasurementId        String @default("")   // e.g. G-XXXXXXXXXX
  metaPixelId             String @default("")   // e.g. 123456789012345
  googleAdsConversionId   String @default("")   // e.g. AW-123456789
  googleAdsConversionLabel String @default("")  // e.g. AbC-D_efG-h12_IjK

  // ── Meta Conversions API — server-side (leave blank to disable) ──
  metaAccessToken         String @default("") @db.Text  // from Events Manager → Settings → Conversions API
  metaTestEventCode       String @default("")           // optional, for testing in Events Manager "Test Events" tab

  // ── GA4 Measurement Protocol — server-side (leave blank to disable) ──
  ga4ApiSecret            String @default("")   // from GA4 Admin → Data Streams → your stream → Measurement Protocol API secrets

  // ── Google Ads API — server-side conversion upload (leave blank to disable) ──
  googleAdsDeveloperToken   String @default("") @db.Text  // from Google Ads → Tools → API Center
  googleAdsOAuthClientId    String @default("") @db.Text  // from Google Cloud Console → OAuth 2.0 Client ID
  googleAdsOAuthClientSecret String @default("") @db.Text // from the same OAuth Client
  googleAdsRefreshToken     String @default("") @db.Text  // auto-filled by the "Connect Google Ads Account" button in admin
  googleAdsCustomerId       String @default("")           // your Ads account ID, digits only, e.g. 1234567890
  googleAdsLoginCustomerId  String @default("")           // optional — only if this account is under an MCC/manager account
  googleAdsConversionActionId String @default("")         // from Google Ads → Goals → Conversions → your action → "Conversion ID" segment

  // ── Parent Brand Attribution (AR Qudrix framework) ──
  parentBrandName         String @default("AR Qudrix")
  parentBrandUrl          String @default("https://arqudrix.com")
  parentBrandRelationship String @default("A Digital & Technology Company by AR Qudrix")
  parentBrandShort        String @default("by AR Qudrix")   // used only where space is tight

  updatedAt        DateTime @updatedAt
}

model Stat {
  id        String  @id @default(cuid())
  value     String
  label     String
  order     Int     @default(0)
}

// ============================================================
// ADMIN USERS
// ============================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("admin")   // admin, editor, team_member
  
  // Relations
  leads        Lead[]
  teamMember   TeamMember?   // User can have at most one TeamMember profile
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// SERVICES
// ============================================================
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  emoji       String   @default("⭐")
  title       String
  shortDesc   String   @db.Text
  longDesc    String   @db.Text
  features    Json     // string[] stored as JSON — MySQL has no native array type
  seoTitle    String   @default("")
  seoDesc     String   @default("")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// PORTFOLIO
// ============================================================
model PortfolioItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  emoji       String   @default("💼")
  image       String   @default("")
  category    String
  tags        Json     // string[] stored as JSON
  result      String
  shortDesc   String   @db.Text
  challenge   String   @default("") @db.Text
  solution    String   @default("") @db.Text
  results     Json     // string[] stored as JSON
  client      String   @default("")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// BLOG
// ============================================================
model BlogPost {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  excerpt      String   @db.Text
  content      String   @db.Text
  category     String
  image        String   @default("")
  author       String
  authorRole   String   @default("")
  publishedAt  DateTime @default(now())
  readTime     String   @default("5 min read")
  seoTitle     String   @default("")
  seoDesc      String   @default("")
  tags         Json     // string[] stored as JSON
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// CLIENTS & PROJECTS
// ============================================================
model Client {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  phone           String   @default("")
  website         String   @default("")
  logo            String   @default("")
  
  // Company Info
  company         String
  industry        String   @default("")
  employeeCount   String   @default("")
  address         String   @default("")
  city            String   @default("")
  country         String   @default("")
  
  // Relationship
  primaryContact  String   @default("")                    // Contact person name
  contactEmail    String   @default("")
  contactPhone    String   @default("")
  
  // Business Info
  budget          Float    @default(0)                     // Average project budget
  busyPeriod      String   @default("")                    // Seasonal info
  businessNeeds   String   @default("") @db.Text          // What they need
  
  // Relationship with Agency
  status          String   @default("active")             // active, inactive, prospect
  priority        String   @default("medium")             // low, medium, high, vip
  rating          Float    @default(0)                    // Client satisfaction 0-5
  notes           String   @default("") @db.Text          // Internal notes
  
  // Project History
  projects        Project[]
  communications  ClientCommunication[]
  documents       ClientDocument[]
  
  // Analytics
  analytics       ClientAnalytics?
  
  // Financial
  totalSpent      Float    @default(0)
  paymentTerms    String   @default("")                   // Net 30, Net 60, etc
  lastProjectDate DateTime?
  
  // Portal Access
  portalAccess    Boolean  @default(false)
  portalPassword  String   @default("")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Project {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String   @default("") @db.Text
  
  // Client Reference
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  // Project Details
  category        String                                   // Web, Mobile, Design, etc
  budget          Float    @default(0)
  status          String   @default("active")             // active, completed, on-hold, archived
  timeline        String   @default("")                   // "3 months", "6 weeks"
  
  // Team
  teamMembers     String   @default("") @db.Text         // JSON: array of team member ids
  leadDeveloper   String   @default("")
  projectManager  String   @default("")
  
  // Deliverables
  deliverables    String   @default("") @db.Text         // JSON array
  technologies    String   @default("") @db.Text         // JSON array: ["React", "Node.js"]
  
  // Metrics & Results ✨ NEW
  roi             Float    @default(0)                    // Return on investment %
  completionRate  Float    @default(0)                    // 0-100
  clientSatisfaction Float @default(0)                    // 0-5
  
  // Results Highlights ✨ NEW
  resultsHighlights String @default("") @db.Text         // JSON: [{"label": "Traffic", "value": "+200%", "icon": "📈"}]
  keyMetrics      String   @default("") @db.Text         // JSON: [{"name": "Conversion", "before": "2%", "after": "5%"}]
  
  // Media
  coverImage      String   @default("")
  gallery         String   @default("") @db.Text         // JSON array of all images
  
  // Before & After Gallery ✨ NEW
  beforeAfterGallery String @default("") @db.Text       // JSON: [{"before": "url", "after": "url", "label": "Homepage"}]
  
  // Case Study ✨ ENHANCED
  caseStudy       String   @default("") @db.Text         // Full case study content (HTML)
  caseStudyPDF    String   @default("")                   // PDF URL for download
  challenge       String   @default("") @db.Text         // Client's challenge
  solution        String   @default("") @db.Text         // Our solution
  outcome         String   @default("") @db.Text         // Results achieved
  
  // Testimonial ✨ ENHANCED
  testimonial     String   @default("")                   // Client quote
  testimonialAuthor String @default("")                   // Who said it
  testimonialRole String   @default("")                   // Their position
  testimonialImage String   @default("")                  // Avatar
  
  // Portfolio Settings ✨ NEW
  featuredInPortfolio Boolean @default(false)
  displayOrder    Int      @default(0)                   // Sort order on portfolio
  showMetrics     Boolean  @default(true)
  showTestimonial Boolean  @default(true)
  
  // SEO & Publishing ✨ NEW
  published       Boolean  @default(false)
  seoTitle        String   @default("")
  seoDescription  String   @default("")
  tags            String   @default("") @db.Text         // JSON array
  
  // Dates
  startDate       DateTime?
  endDate         DateTime?
  dueDate         DateTime?
  publishedAt     DateTime?
  
  // Portal & Tracking
  portalLink      String   @default("")
  progressNotes   String   @default("") @db.Text
  
  // Analytics
  analytics       ProjectAnalytics?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClientCommunication {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  type            String                                   // email, call, meeting, message
  subject         String
  content         String   @db.Text
  
  // Meeting Info
  meetingDate     DateTime?
  meetingLink     String   @default("")                   // Zoom/Meet link
  attendees       String   @default("")                   // JSON array
  notes           String   @default("") @db.Text
  
  // File Attachments
  attachments     String   @default("") @db.Text         // JSON array of file urls
  
  // Status
  status          String   @default("pending")           // pending, completed, archived
  followUpDate    DateTime?
  
  createdBy       String   @default("admin")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClientDocument {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  title           String
  type            String                                   // contract, nda, invoice, agreement
  fileUrl         String
  fileSize        Int      @default(0)
  
  # Versions
  version         Int      @default(1)
  expiryDate      DateTime?
  
  # Access
  isPublic        Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// ANALYTICS & REPORTING
// ============================================================
model ProjectAnalytics {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Traffic & Engagement
  pageViews       Int      @default(0)
  uniqueVisitors  Int      @default(0)
  bounceRate      Float    @default(0)                    // 0-100%
  avgSessionTime  Float    @default(0)                    // seconds
  
  // Conversions
  leads           Int      @default(0)
  conversions     Int      @default(0)
  conversionRate  Float    @default(0)                    // 0-100%
  
  // Revenue & ROI
  revenue         Float    @default(0)
  cost            Float    @default(0)
  roi             Float    @default(0)                    // calculated
  
  // Engagement
  clicks          Int      @default(0)
  shares          Int      @default(0)
  comments        Int      @default(0)
  
  // Timeline
  trackingPeriod  String   @default("monthly")           // daily, weekly, monthly
  startDate       DateTime @default(now())
  endDate         DateTime @default(now())
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClientAnalytics {
  id              String   @id @default(cuid())
  clientId        String   @unique
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  // Engagement
  totalProjectsDelivered Int @default(0)
  totalSpent      Float    @default(0)
  avgProjectValue Float    @default(0)
  
  // Satisfaction & Retention
  satisfactionScore Float  @default(0)                    // 0-5
  retentionRate   Float    @default(0)                    // 0-100%
  repeatClient    Boolean  @default(false)
  
  // Timeline
  firstProjectDate DateTime?
  lastProjectDate  DateTime?
  lifetimeMonths   Int      @default(0)
  
  // Status
  status          String   @default("active")
  riskLevel       String   @default("low")               // low, medium, high
  
  updatedAt       DateTime @updatedAt
}

model RevenueReport {
  id              String   @id @default(cuid())
  
  // Period
  period          String                                  // "2024-01", "2024-Q1", "2024"
  year            Int
  month           Int      @default(0)
  quarter         Int      @default(0)
  
  // Revenue
  totalRevenue    Float    @default(0)
  projectRevenue  Float    @default(0)
  serviceRevenue  Float    @default(0)
  
  // Costs
  totalCosts      Float    @default(0)
  staffCosts      Float    @default(0)
  operatingCosts  Float    @default(0)
  
  // Metrics
  profit          Float    @default(0)
  profitMargin    Float    @default(0)                    // 0-100%
  growthRate      Float    @default(0)                    // month-over-month %
  
  // Projects
  projectCount    Int      @default(0)
  avgProjectValue Float    @default(0)
  
  // Comparison
  previousPeriod  String   @default("")                   // For comparison
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([period, year])
}

model TeamPerformance {
  id              String   @id @default(cuid())
  teamMemberId    String   @unique
  teamMember      TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  
  // Projects & Workload
  projectsCompleted Int    @default(0)
  projectsInProgress Int   @default(0)
  utilization     Float    @default(0)                    // 0-100%
  
  // Quality & Performance
  avgProjectRating Float   @default(0)                    // 0-5
  clientSatisfaction Float @default(0)                    // 0-5
  onTimeDelivery  Float    @default(0)                    // 0-100%
  qualityScore    Float    @default(0)                    // 0-100%
  
  // Skills & Development
  skillsTags      String   @default("") @db.Text         // JSON array
  certifications  String   @default("") @db.Text         // JSON array
  trainingHours   Int      @default(0)
  
  // Metrics
  billableHours   Float    @default(0)
  revenue         Float    @default(0)
  
  // Status
  performanceRating String  @default("average")          // excellent, good, average, needs_improvement
  lastEvaluation  DateTime?
  
  updatedAt       DateTime @updatedAt
}

model LeadAnalytics {
  id              String   @id @default(cuid())
  
  // Sources
  source          String                                  // organic, paid, referral, direct, email
  
  // Conversion Funnel
  leadsGenerated  Int      @default(0)
  qualified       Int      @default(0)
  contacted       Int      @default(0)
  meetings        Int      @default(0)
  proposals       Int      @default(0)
  converted       Int      @default(0)
  
  // Rates
  qualificationRate Float  @default(0)
  contactRate     Float    @default(0)
  meetingRate     Float    @default(0)
  conversionRate  Float    @default(0)
  
  // Value
  avgLeadValue    Float    @default(0)
  totalValue      Float    @default(0)
  cost            Float    @default(0)
  roi             Float    @default(0)
  
  // Timeline
  period          String                                  // "2024-01"
  year            Int
  month           Int
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// BOOKINGS & CONSULTATIONS
// ============================================================
model ConsultationService {
  id              String   @id @default(cuid())
  
  // Service Details
  name            String                                  // e.g., "Website Consultation"
  slug            String   @unique
  description     String   @db.Text
  icon            String   @default("📞")
  
  // Duration & Pricing
  durationMinutes Int      @default(30)                  // 15, 30, 45, 60
  price           Float    @default(0)                   // 0 = Free
  currency        String   @default("USD")
  
  // Availability
  isAvailable     Boolean  @default(true)
  maxBookingsPerDay Int    @default(5)
  
  // Meeting Configuration
  meetingType     String   @default("zoom")             // zoom, google_meet, phone, in-person
  locationLink    String   @default("")                 // Zoom/Meet link template
  address         String   @default("")                 // For in-person
  
  // Team Assignment
  assignedTeamMembers String @default("[]") @db.Text    // JSON array of IDs
  
  // Customization
  agendaTemplate  String   @default("") @db.Text       // Pre-filled agenda
  followUpTemplate String  @default("") @db.Text       // Follow-up message template
  
  // Display
  order           Int      @default(0)
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  
  // Relations
  bookings        Booking[]
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Booking {
  id              String   @id @default(cuid())
  bookingNumber   String   @unique
  
  // Service & Scheduling
  serviceId       String
  service         ConsultationService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  scheduledDate   DateTime
  scheduledTime   String                                  // HH:MM format
  endTime         String                                  // HH:MM format
  
  // Client Information
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  guestName       String                                  // For non-registered clients
  guestEmail      String
  guestPhone      String
  guestCompany    String   @default("")
  
  // Assigned Team Member
  teamMemberId    String
  teamMember      TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Restrict)
  
  // Booking Details
  subject         String
  message         String   @db.Text
  budget          String   @default("")                  // Optional budget info
  projectType     String   @default("")
  
  // Meeting Details
  meetingLink     String   @default("")                  // Generated Zoom/Meet link
  callInNumber    String   @default("")                  // Phone call-in details
  password        String   @default("")                  // Meeting password
  
  // Status & Tracking
  status          String   @default("pending")          // pending, confirmed, completed, cancelled, no-show
  confirmationSent Boolean  @default(false)
  reminderSent    Boolean  @default(false)
  reminderSentAt  DateTime?
  
  // Notes & Follow-up
  internalNotes   String   @default("") @db.Text        // Admin notes
  meetingNotes    String   @default("") @db.Text        // Notes from the meeting
  actionItems     String   @default("[]") @db.Text      // JSON array
  
  // Follow-up
  followUpEmail   String   @default("")
  followUpDate    DateTime?
  followUpSent    Boolean  @default(false)
  
  // Feedback
  clientFeedback  String   @default("")                  // How did we do?
  rating          Int      @default(0)                   // 1-5 stars
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cancelledAt     DateTime?
  completedAt     DateTime?
}

model TimeSlot {
  id              String   @id @default(cuid())
  
  // Team Member Availability
  teamMemberId    String
  teamMember      TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  
  // Date & Time
  dayOfWeek       Int                                     // 0-6 (Sunday-Saturday)
  startTime       String                                  // HH:MM format
  endTime         String                                  // HH:MM format
  
  // Status
  isAvailable     Boolean  @default(true)
  isBlocked       Boolean  @default(false)               // Vacation, etc
  blockReason     String   @default("")
  
  // Specific Dates (Overrides recurring)
  specificDate    DateTime?                              // If set, overrides dayOfWeek
  
  // Maximum Bookings
  maxSlots        Int      @default(1)
  bookedSlots     Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BookingAvailability {
  id              String   @id @default(cuid())
  
  // Service Availability
  serviceId       String
  
  // Date Range
  dateFrom        DateTime
  dateTo          DateTime
  
  // Time Range
  startTime       String                                  // HH:MM
  endTime         String                                  // HH:MM
  
  // Days Available (JSON array: [1,2,3,4,5])
  daysOfWeek      String   @default("[1,2,3,4,5]")      // Mon-Fri
  
  // Blackout Dates (Vacation, etc)
  blackoutDates   String   @default("[]") @db.Text      // JSON array of dates
  
  // Break Times
  breakTimes      String   @default("[]") @db.Text      // JSON: [{start: "12:00", end: "13:00"}]
  
  // Timezone
  timezone        String   @default("UTC")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BookingTemplate {
  id              String   @id @default(cuid())
  name            String
  
  // Email Templates
  confirmationEmail String @default("") @db.Text
  reminderEmail   String   @default("") @db.Text
  followUpEmail   String   @default("") @db.Text
  
  // Calendar Invite
  calendarTitle   String   @default("")
  calendarDesc    String   @default("") @db.Text
  
  // Status
  active          Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// TEAM
// ============================================================
model TeamMember {
  id              String   @id @default(cuid())
  slug            String   @unique                         // For dynamic pages: /team/john-doe
  email           String   @unique
  name            String
  role            String
  bio             String   @db.Text
  shortBio        String   @default("")                    // Quick 1-liner for card
  avatar          String   @default("")                    // Profile image URL
  coverImage      String   @default("")                    // Cover photo for personal page
  emoji           String   @default("👤")
  
  // Social & Contact
  linkedin        String   @default("")
  twitter         String   @default("")
  website         String   @default("")
  phone           String   @default("")
  
  // Detailed Info
  specialization  String   @default("")                    // e.g., "Frontend Development"
  experience      String   @default("")                    // e.g., "5 years"
  skills          Json     @default("[]")                  // string[] - stored as JSON
  achievements    String   @default("") @db.Text          // Rich achievements/portfolio
  
  // Access Control
  userId          String?                                  // Link to User for self-profile editing
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  canEditProfile  Boolean  @default(false)                 // Allows user to edit own profile
  
  // Analytics & Performance
  performance     TeamPerformance?
  
  // Display
  order           Int      @default(0)
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  
  // SEO
  seoTitle        String   @default("")
  seoDesc         String   @default("") @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// TESTIMONIALS
// ============================================================
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  initials  String
  image     String   @default("")
  rating    Int      @default(5)
  text      String   @db.Text
  order     Int      @default(0)
  active    Boolean  @default(true)
}

// ============================================================
// CRM — LEADS (Phase 3 foundation)
// ============================================================
model Lead {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String   @default("")
  company       String   @default("")
  subject       String
  service       String   @default("")
  message       String   @db.Text
  valueEstimate Float?                        // estimated deal value, editable in admin
  notes         String   @default("") @db.Text // internal notes (not visible to lead)
  stage         String   @default("new")      // new, qualifying, proposal_sent, won, lost
  source        String   @default("contact_form")

  // ── Attribution — for server-side conversion matching ──
  gclid         String   @default("")   // Google Ads click ID, captured from the URL at form load
  fbclid        String   @default("")   // Meta click ID, captured from the URL at form load
  fbp           String   @default("")   // Meta browser ID (_fbp cookie) — improves CAPI match quality
  fbc           String   @default("")   // Meta click cookie (_fbc) — improves CAPI match quality
  landingPage   String   @default("") @db.Text  // full URL the visitor first landed on
  ip            String   @default("")
  userAgent     String   @default("") @db.Text

  // ── Server-side conversion send status (for debugging / audit) ──
  metaCapiSentAt      DateTime?
  metaCapiStatus      String   @default("")  // "sent", "failed", "" (not configured / no attempt)
  googleAdsSentAt     DateTime?
  googleAdsStatus     String   @default("")
  ga4SentAt           DateTime?
  ga4Status           String   @default("")

  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// API KEYS — for external systems (e.g. ARQ Software's central
// management system) to pull data from this site via /api/external/v1/*
// ============================================================
model ApiKey {
  id          String    @id @default(cuid())
  name        String                          // human label, e.g. "ARQ Software Sync"
  keyHash     String    @unique                // SHA-256 hash of the actual key — raw key is shown once at creation, never stored
  keyPrefix   String                           // first 12 chars of raw key, shown in admin UI to identify which key is which
  scopes      Json                             // e.g. ["leads:read","services:read","blog:read","portfolio:read"]
  lastUsedAt  DateTime?
  active      Boolean   @default(true)
  createdBy   String?
  createdAt   DateTime  @default(now())
}

// ============================================================
// FORM EVENTS — granular interaction tracking on the Contact form
// (who focused which field, in what order, before submitting or
// abandoning) so the admin can see funnel drop-off, not just
// completed leads. No keystrokes are captured — only which field
// was interacted with and when, which is privacy-respecting while
// still answering "what is this visitor doing".
// ============================================================
model FormEvent {
  id         String   @id @default(cuid())
  sessionId  String                          // random ID generated client-side per page visit
  eventType  String                          // form_start, field_focus, field_complete, form_submit, form_error
  fieldName  String   @default("")           // e.g. "email", "phone", "message" — empty for form_start/form_submit
  page       String   @default("")
  createdAt  DateTime @default(now())

  @@index([sessionId])
}

