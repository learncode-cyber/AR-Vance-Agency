    "@sentry/nextjs": "^11.1.0",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.1",
