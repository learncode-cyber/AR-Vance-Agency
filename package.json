{
  "name": "ar-vance-agency-platform",
  "version": "1.0.0",
  "description": "AR Vance Agency Platform - Complete SaaS Solution",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "docker:build": "docker build -t ar-vance-platform .",
    "docker:run": "docker run -p 3000:3000 ar-vance-platform",
    "rbac:sync": "ts-node --compiler-options '{\"module\":\"commonjs\"}' prisma/sync-roles.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build:lowmem": "prisma generate && SKIP_BUILD_CHECKS=1 next build",
    "check:env": "node scripts/check-env.js",
    "prestart": "node scripts/check-env.js",
    "prisma:seed": "prisma db seed",
    "prebuild": "node scripts/repo-hygiene.js",
    "prebuild:lowmem": "node scripts/repo-hygiene.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
