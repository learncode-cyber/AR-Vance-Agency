{
  "root": true,
  "extends": ["next/core-web-vitals", "next/typescript"],
  "ignorePatterns": ["archive/", "node_modules/", ".next/", "coverage/", "public/", "next-env.d.ts"],
  "rules": {
    // Style/maintainability signals: reported as warnings so they show up in
    // `npm run lint` but don't block deploys. Correctness rules stay errors.
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
    // Apostrophes/quotes in JSX text render correctly; the rule is purely stylistic.
    "react/no-unescaped-entities": "off"
  },
  "overrides": [
    { "files": ["__tests__/**", "e2e/**", "*.config.ts", "*.config.js"], "rules": { "@typescript-eslint/no-require-imports": "off", "@typescript-eslint/no-explicit-any": "off" } }
  ]
}
