# Production Environment - DO NOT COMMIT REAL SECRETS!
# Use GitHub Secrets instead

NODE_ENV=production
DATABASE_URL=mysql://user:password@prod-db.example.com:3306/agency_prod

JWT_SECRET=use-github-secrets-for-production

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@arqudrix.com
SMTP_PASS=use-github-secrets

STRIPE_SECRET_KEY=sk_live_your_production_key
STRIPE_PUBLIC_KEY=pk_live_your_production_key
STRIPE_WEBHOOK_SECRET=whsec_live_secret

ANTHROPIC_API_KEY=sk-ant-production-key

NEXT_PUBLIC_ADMIN_PATH=kali_master
NEXT_PUBLIC_APP_URL=https://arqudrix.com

R2_ACCESS_KEY_ID=prod-r2-key
R2_SECRET_ACCESS_KEY=prod-r2-secret
R2_BUCKET_NAME=prod-bucket
R2_REGION=auto

# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Monitoring
MONITORING_ENABLED=true
