# Staging Environment

NODE_ENV=production
DATABASE_URL=mysql://user:password@staging-db.example.com:3306/agency_staging

JWT_SECRET=staging-secret-key-min-32-characters-long-key

SMTP_HOST=smtp.staging.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=staging@example.com
SMTP_PASS=staging-email-password

STRIPE_SECRET_KEY=sk_test_staging_key
STRIPE_PUBLIC_KEY=pk_test_staging_key
STRIPE_WEBHOOK_SECRET=whsec_staging_secret

ANTHROPIC_API_KEY=sk-ant-staging-key

NEXT_PUBLIC_ADMIN_PATH=kali_master
NEXT_PUBLIC_APP_URL=https://staging.arqudrix.com

R2_ACCESS_KEY_ID=staging-r2-key
R2_SECRET_ACCESS_KEY=staging-r2-secret
R2_BUCKET_NAME=staging-bucket
R2_REGION=auto
